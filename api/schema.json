{
  "system": "AutoMind",
  "description": "基於 AutoML 與 LLM 自動化建立個人 AI 應用",
  "architecture": {
    "layers": {
      "application": {
        "description": "RESTful API 層，負責接收請求與回傳 JSON 結果",
        "framework": "FastAPI",
        "features": ["API Gateway", "Swagger UI", "Session-based Auth"]
      },
      "service": {
        "description": "邏輯層，負責模組核心運算與流程控制",
        "modules": [
          "Data Fusion Module",
          "Meta Generator",
          "Logic Applier",
          "AutoML Trainer",
          "Model Monitor"
        ]
      },
      "integration": {
        "description": "外部服務整合層，連接 LLM、MindsDB、資料庫與儲存",
        "components": ["OpenAI API", "MindsDB", "MSSQL"]
      },
      "monitoring": {
        "description": "監控與紀錄層，追蹤系統與模型效能",
        "tools": ["Prometheus", "Grafana", "Logging System"]
      }
    }
  },
  "modules": [
    {
      "name": "Data Fusion Module",
      "prefix": "/api/data-fusion",
      "description": "整合多個資料表並生成初步特徵",
      "endpoints": [
        {
          "method": "POST",
          "path": "/merge",
          "description": "自動辨識 join key 並合併多表"
        },
        {
          "method": "POST",
          "path": "/feature/generate",
          "description": "自動生成衍生特徵"
        },
        {
          "method": "GET",
          "path": "/preview",
          "description": "預覽融合後資料"
        },
        { "method": "DELETE", "path": "/clear", "description": "清除暫存資料" }
      ],
      "example_response": {
        "fusion_id": "dfm_20251007_001",
        "features": ["age_mean", "income_ratio", "purchase_freq"],
        "rows": 10234,
        "columns": 45
      }
    },
    {
      "name": "Meta Generator",
      "prefix": "/api/meta-generator",
      "description": "根據資料結構與摘要生成 LLM Prompt",
      "endpoints": [
        {
          "method": "POST",
          "path": "/generate-prompt",
          "description": "根據資料自動生成 LLM prompt"
        },
        {
          "method": "GET",
          "path": "/prompt/{fusion_id}",
          "description": "查詢資料集對應的 prompt"
        }
      ],
      "example_response": {
        "prompt_id": "meta_20251007_001",
        "prompt_text": "Analyze dataset with columns: age, income, purchase_freq. Detect anomalies and suggest feature scaling methods."
      }
    },
    {
      "name": "Logic Applier",
      "prefix": "/api/logic-applier",
      "description": "根據 LLM 建議進行資料清理與特徵工程",
      "endpoints": [
        {
          "method": "POST",
          "path": "/apply-llm",
          "description": "套用 LLM 建議進行資料清理"
        },
        {
          "method": "GET",
          "path": "/status/{fusion_id}",
          "description": "查詢前處理進度"
        },
        {
          "method": "GET",
          "path": "/preview/{fusion_id}",
          "description": "預覽清理後資料"
        },
        {
          "method": "POST",
          "path": "/export",
          "description": "匯出處理後資料 (CSV/Parquet)"
        }
      ],
      "example_response": {
        "cleaned_id": "proc_20251007_001",
        "removed_rows": 123,
        "imputed_columns": ["age", "salary"],
        "encoded_features": ["gender_onehot"],
        "status": "completed"
      }
    },
    {
      "name": "AutoML Trainer",
      "prefix": "/api/automl",
      "description": "結合 MindsDB 自動訓練與部署模型",
      "endpoints": [
        {
          "method": "POST",
          "path": "/train",
          "description": "觸發 AutoML 模型訓練"
        },
        {
          "method": "GET",
          "path": "/status/{train_id}",
          "description": "查詢訓練進度與結果"
        },
        { "method": "GET", "path": "/models", "description": "列出已訓練模型" },
        {
          "method": "POST",
          "path": "/predict",
          "description": "使用模型進行預測"
        },
        {
          "method": "DELETE",
          "path": "/model/{model_id}",
          "description": "刪除模型"
        }
      ],
      "example_response": {
        "train_id": "auto_20251007_001",
        "best_model": "xgboost_v3",
        "metrics": {
          "accuracy": 0.912,
          "f1_score": 0.904
        },
        "deployment_url": "http://localhost:8080/model/xgboost_v3/predict"
      }
    },
    {
      "name": "Model Monitor",
      "prefix": "/api/monitor",
      "description": "監控模型效能、健康狀態與資料漂移",
      "endpoints": [
        {
          "method": "GET",
          "path": "/health/{model_id}",
          "description": "查詢模型健康狀態"
        },
        {
          "method": "GET",
          "path": "/drift/{model_id}",
          "description": "資料漂移檢測"
        },
        {
          "method": "GET",
          "path": "/metrics/{model_id}",
          "description": "查詢模型評估指標"
        },
        { "method": "POST", "path": "/alert", "description": "觸發異常警報" }
      ],
      "example_response": {
        "model_id": "xgboost_v3",
        "status": "healthy",
        "drift_score": 0.07,
        "last_update": "2025-10-07T12:45:00Z"
      }
    }
  ],
  "data_flow": [
    "Raw Tables → Data Fusion Module → Meta Generator → LLM Service → Logic Applier → AutoML (MindsDB) → Monitor"
  ],
  "tech_stack": {
    "api_framework": "FastAPI",
    "llm_provider": "OpenAI GPT-4/5 or Local Llama 3",
    "automl_engine": "MindsDB",
    "database": "MSSQL",
    "storage": "MindsDB/MinIO",
    "monitoring": "Prometheus + Grafana",
    "authentication": "Session-based"
  }
}
